<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProjectManager.Views.MainPage">

    <CollectionView ItemsSource="{Binding Movies}" SelectionMode="Single" SelectionChanged="OnSelected">
        <CollectionView.ItemTemplate>
            <DataTemplate>
                <HorizontalStackLayout Padding="10">
                    <Image Source="{Binding ImagePath}" WidthRequest="60" HeightRequest="60"/>
                    <VerticalStackLayout>
                        <Label Text="{Binding Title}" FontSize="18"/>
                        <Label Text="{Binding Rating}" FontSize="14"/>
                    </VerticalStackLayout>
                </HorizontalStackLayout>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>

</ContentPage>