<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             x:Class="ProjectManager.Views.AddMoviePage">

	<ScrollView>
		<VerticalStackLayout Padding="16">

			<Entry Placeholder="Název" Text="{Binding Title}" />
			<Entry Placeholder="Popis" Text="{Binding Description}" />
			<Entry Placeholder="Rok" Text="{Binding Year}" Keyboard="Numeric"/>
			<Entry Placeholder="Žánr" Text="{Binding Genre}" />
			<Entry Placeholder="Hodnocení" Text="{Binding Rating}" Keyboard="Numeric"/>

			<Button Text="Uložit" Command="{Binding SaveCommand}" />

		</VerticalStackLayout>
	</ScrollView>

</ContentPage>